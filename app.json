{
  "expo": {
    "name": "StonkWatcher",
    "slug": "StonkWatcher",
    "version": "1.0.0",
    "scheme": "stonkwatcher",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon.png",
    "userInterfaceStyle": "light",
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "xyz.stonkwatcher.app",
      "usesAppleSignIn": true,
      "icon": "./assets/images/app-icon.png"
    },
    "android": {
      "package": "xyz.stonkwatcher.app.uat",
      "adaptiveIcon": {
        "backgroundColor": "#101010",
        "foregroundImage": "./assets/images/app-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-status-bar",
      "expo-router",
      "expo-web-browser",
      "expo-sharing",
      "expo-apple-authentication"
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "47eab330-6b7c-47be-b557-f098c5bc40a2"
      }
    },
    "owner": "watchingdogzs-team",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/47eab330-6b7c-47be-b557-f098c5bc40a2"
    }
  }
}
